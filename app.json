{
  "expo": {
    "name": "POKAPOK",
    "slug": "pokapok",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/favicon-pokapok.png",
    "scheme": "pokapok",
    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "./assets/images/favicon-pokapok.png"
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B5CFF",
        "foregroundImage": "./assets/images/favicon-pokapok.png"
      },
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon-pokapok.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B5CFF",
          "android": {
            "image": "./assets/images/favicon-pokapok.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-image",
      "expo-web-browser"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}